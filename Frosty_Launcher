#!/usr/bin/env bash
set -e

REPO_DIR="Petro.Frosty.exe"

if [[ -d "$REPO_DIR" ]]; then
    # Already cloned before — just cd and run
    cd "$REPO_DIR"
    if [[ "$(id -u)" -eq 0 ]]; then
        bash install.sh
    else
        sudo bash install.sh
    fi
    exit 0
fi

# ---- First run only, below this line ----

echo "First run detected — setting up..."

if [[ "$(id -u)" -eq 0 ]]; then
    RUN_AS_ROOT=""
else
    if command -v sudo >/dev/null 2>&1; then
        RUN_AS_ROOT="sudo"
    else
        echo "This system has no 'sudo' installed and you're not logged in as root."
        echo "You'll need the root password to continue."
        echo ""
        echo "Attempting: su -c 'apt update -y && apt install -y sudo'"
        su -c "apt update -y && apt install -y sudo"
        RUN_AS_ROOT="sudo"
    fi
fi

$RUN_AS_ROOT apt update -y

if ! command -v git >/dev/null 2>&1; then
    echo "git not found — installing..."
    $RUN_AS_ROOT apt install -y git
fi

git clone https://github.com/Ronak-gaming/Petro.Frosty.exe.git

cd "$REPO_DIR"
$RUN_AS_ROOT bash install.sh
